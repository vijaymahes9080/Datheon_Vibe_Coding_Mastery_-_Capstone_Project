# ==============================================================================
# SkillForge AI — Environment Configuration Example
# Copy this file to .env.local and populate with your own project credentials.
# NEVER commit .env or .env.local containing real production secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Auth Credentials
# Obtain from https://supabase.com -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. AI Model Provider Credentials
# SkillForge supports Google Gemini, OpenAI, or deterministic fallback.
# ------------------------------------------------------------------------------
# AI Provider selection: 'gemini' | 'openai' | 'demo'
AI_PROVIDER=gemini

# Google Gemini API Key (Recommended for fast inference & free tier)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...

# OpenAI API Key (Optional alternative)
# Obtain from https://platform.openai.com/
OPENAI_API_KEY=sk-proj-...

# ------------------------------------------------------------------------------
# 3. Application URL & Environment
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
